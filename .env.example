GOOGLE_CLIENT_SECRET=

# Email — Resend API for transactional emails
RESEND_API_KEY=
CONTACT_EMAIL_TO=

# Security — Session & Auth
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Webhooks & Cron
CRON_SECRET=
